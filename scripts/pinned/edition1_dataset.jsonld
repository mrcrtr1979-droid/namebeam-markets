{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "name": "Namebeam AI Visibility Record, Edition 1",
  "description": "Dated record of which businesses AI answer engines name for local questions in US markets, with the sources the engines returned. Edition 1 covers 2026-09-01 to 2026-10-07 (36 run days). The data pack holds 10152 answer rows (one per raw answer file, with the names each engine returned and the SHA-256 of the raw file), 35205 source URL rows, 28 rows from a Siri panel run by hand, and a metrics table that gives the denominator of every figure. Perplexity, OpenAI, Anthropic and Gemini were called through their programming interfaces, and Google results pages were read. Every file is listed in a SHA-256 manifest and a verify script checks the pack. Licensed CC BY 4.0.",
  "url": "https://markets.namebeam.ai/edition-1",
  "version": "Edition 1 (staged)",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "isAccessibleForFree": true,
