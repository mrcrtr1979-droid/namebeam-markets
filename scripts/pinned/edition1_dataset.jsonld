  ],
  "temporalCoverage": "2026-09-01/2026-10-07",
  "spatialCoverage": {
    "@type": "Place",
    "name": "United States"
  },
  "measurementTechnique": "One fixed question per business or segment is put to each engine every day; each answer is stored as a raw file with its SHA-256. See the method note for the settings of every engine.",
